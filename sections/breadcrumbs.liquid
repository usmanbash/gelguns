{{ 'component-breadcrumbs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign breadcrumb_items = ''
  assign current_path = request.path
  
  if template.name == 'product'
    assign breadcrumb_items = breadcrumb_items | append: 'product'
  elsif template.name == 'collection'
    assign breadcrumb_items = breadcrumb_items | append: 'collection'
  elsif template.name == 'page'
    assign breadcrumb_items = breadcrumb_items | append: 'page'
  elsif template.name == 'article'
    assign breadcrumb_items = breadcrumb_items | append: 'article'
  endif
-%}

<nav class="breadcrumbs page-width section-{{ section.id }}-padding" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ routes.root_url }}" class="breadcrumbs__link" itemprop="item">
        <span class="breadcrumbs__icon">
          {{- 'icon-homepage.svg' | inline_asset_content -}}
        </span>
        <span itemprop="name" class="visually-hidden">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    
    {%- if template.name == 'product' -%}
      {%- if collection -%}
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="breadcrumbs__separator">/</span>
          <a href="{{ collection.url }}" class="breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ collection.title }}</span>
          </a>
          <meta itemprop="position" content="2" />
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__separator">/</span>
        <span class="breadcrumbs__current" itemprop="name">{{ product.title }}</span>
        <meta itemprop="position" content="{% if collection %}3{% else %}2{% endif %}" />
      </li>
    {%- elsif template.name == 'collection' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__separator">/</span>
        <span class="breadcrumbs__current" itemprop="name">{{ collection.title }}</span>
        <meta itemprop="position" content="2" />
      </li>
    {%- elsif template.name == 'page' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__separator">/</span>
        <span class="breadcrumbs__current" itemprop="name">{{ page.title }}</span>
        <meta itemprop="position" content="2" />
      </li>
    {%- elsif template.name == 'article' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__separator">/</span>
        <a href="{{ blog.url }}" class="breadcrumbs__link" itemprop="item">
          <span itemprop="name">{{ blog.title }}</span>
        </a>
        <meta itemprop="position" content="2" />
      </li>
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__separator">/</span>
        <span class="breadcrumbs__current" itemprop="name">{{ article.title }}</span>
        <meta itemprop="position" content="3" />
      </li>
    {%- endif -%}
  </ol>
</nav>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Breadcrumbs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}

