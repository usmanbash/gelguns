{% comment %} Metafields 1–10: bar width = score × 10 (%). Rows hidden when empty. {% endcomment %}
{%- liquid
  assign power_raw = product.metafields.custom.power.value | default: product.metafields.custom.power
  assign speed_raw = product.metafields.custom.speed.value | default: product.metafields.custom.speed
  assign precision_raw = product.metafields.custom.precision.value | default: product.metafields.custom.precision
  assign reach_raw = product.metafields.custom.reach.value | default: product.metafields.custom.reach

  assign show_power = false
  assign show_speed = false
  assign show_precision = false
  assign show_reach = false
  unless power_raw == blank
    assign show_power = true
  endunless
  unless speed_raw == blank
    assign show_speed = true
  endunless
  unless precision_raw == blank
    assign show_precision = true
  endunless
  unless reach_raw == blank
    assign show_reach = true
  endunless

  assign show_specs = false
  if show_power or show_speed or show_precision or show_reach
    assign show_specs = true
  endif

  assign power = power_raw | plus: 0
  assign speed = speed_raw | plus: 0
  assign precision_score = precision_raw | plus: 0
  assign reach = reach_raw | plus: 0

  if power > 10
    assign power = 10
  endif
  if power < 0
    assign power = 0
  endif
  if speed > 10
    assign speed = 10
  endif
  if speed < 0
    assign speed = 0
  endif
  if precision_score > 10
    assign precision_score = 10
  endif
  if precision_score < 0
    assign precision_score = 0
  endif
  if reach > 10
    assign reach = 10
  endif
  if reach < 0
    assign reach = 0
  endif

  assign power_w = power | times: 10
  assign speed_w = speed | times: 10
  assign precision_w = precision_score | times: 10
  assign reach_w = reach | times: 10

  assign specs_label_power_default = 'products.specs.power' | t
  assign specs_label_speed_default = 'products.specs.speed' | t
  assign specs_label_precision_default = 'products.specs.precision' | t
  assign specs_label_reach_default = 'products.specs.reach' | t

  assign specs_label_power = settings.specs_label_power | default: specs_label_power_default
  assign specs_label_speed = settings.specs_label_speed | default: specs_label_speed_default
  assign specs_label_precision = settings.specs_label_precision | default: specs_label_precision_default
  assign specs_label_reach = settings.specs_label_reach | default: specs_label_reach_default
-%}
{%- if show_specs -%}
  <div class="specs">
    <div class="bars">
      {%- if show_power -%}
        <div class="bar-text">
          <span class="bar-name">{{ specs_label_power }}:</span>
          <span class="bar-score">{{ power }}</span>
        </div>
        <div class="container-bar">
          <div class="bar" style="width: {{ power_w }}%;"></div>
        </div>
      {%- endif -%}

      {%- if show_speed -%}
        <div class="bar-text">
          <span class="bar-name">{{ specs_label_speed }}:</span>
          <span class="bar-score">{{ speed }}</span>
        </div>
        <div class="container-bar">
          <div class="bar" style="width: {{ speed_w }}%;"></div>
        </div>
      {%- endif -%}

      {%- if show_precision -%}
        <div class="bar-text">
          <span class="bar-name">{{ specs_label_precision }}:</span>
          <span class="bar-score">{{ precision_score }}</span>
        </div>
        <div class="container-bar">
          <div class="bar" style="width: {{ precision_w }}%;"></div>
        </div>
      {%- endif -%}

      {%- if show_reach -%}
        <div class="bar-text">
          <span class="bar-name">{{ specs_label_reach }}:</span>
          <span class="bar-score">{{ reach }}</span>
        </div>
        <div class="container-bar">
          <div class="bar" style="width: {{ reach_w }}%;"></div>
        </div>
      {%- endif -%}
    </div>
  </div>
  <style>
    .container-bar {
      background-color: #e5e5e5;
      width: 100%;
      height: 5px;
      display: table;
      border-radius: 5px;
    }

    .bar {
      background-color: #0e0e0e;
      height: 100%;
      border-style: solid;
      border-width: 0 4px 0 0;
      border-color: #29a4ef;
      display: block !important;
      border-radius: 5px;
      max-width: 100%;
      min-width: 0;
      transition: width 0.25s ease;
    }

    .specs {
      padding: 3px 5px 6px 5px;
      border-style: solid;
      border-width: 1px 0 1px 0;
      border-color: #e7e7e7;
      border-radius: 0;
      margin: 7px 0;
    }

    .card-box {
      background-color: #f9f9f9;
    }

    .bar-name {
      float: left;
    }

    .bar-score {
      float: right;
    }

    .bar-text {
      display: flow-root;
      width: 100%;
      margin-top: 5px;
      font-weight: 600;
    }

    .bar-text:first-child {
      margin-top: 0px;
    }

    .bar-text span {
      font-family: Manrope;
      color: #222529;
      font-size: 0.7em;
      line-height: 1.5;
      letter-spacing: 0em;
    }
  </style>
{%- endif -%}
