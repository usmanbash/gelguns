{% comment %}
  Renders a collection card

  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - columns: {Number}
  - extend_height: {Boolean} Card height extends to available container space. Default: false (optional)
  - wrapper_class: {String} Wrapper class for card (optional)
  - placeholder_image: {String} Placeholder image when collection is empty (optional)
  - custom_image: {Object} Custom image to override collection featured image (optional)

  Usage:
  {% render 'card-collection' %}
{% endcomment %}

{%- liquid
  assign display_image = custom_image | default: card_collection.featured_image
  assign ratio = 1
  if display_image and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif display_image and media_aspect_ratio == 'adapt'
    assign ratio = display_image.aspect_ratio
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
  assign card_color_scheme = settings.card_color_scheme
  assign card_style = settings.card_style
  if wrapper_class == null or wrapper_class == 'none'
    assign card_color_scheme = settings.collection_card_color_scheme
    assign card_style = settings.collection_card_style
  endif
-%}

<div class="card-wrapper animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% else %}collection-card-wrapper{% endif %}">
  <div
      class="
      card
      card--{{ card_style }}
      {% if display_image %} card--media{% else %} card--text{% endif %}
      {% if card_style == 'card' %} color-{{ card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if display_image == nil and card_style == 'card' %} ratio{% endif %}
    "
    style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  >
    <div
      class="card__inner {% if display_image or card_style == 'standard' %} ratio{% endif %}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      {%- if display_image -%}
        <div class="card__media">
          {%- if card_collection != blank -%}
            <a
              href="{{ card_collection.url }}"
              class="full-unstyled-link"
              aria-label="{% if card_collection.title != blank %}{{ card_collection.title | escape }}{% else %}{{ 'onboarding.collection_title' | t | escape }}{% endif %}"
            >
          {%- endif -%}
          <div class="media media--transparent media--hover-effect">
            <img
              srcset="
                {%- if display_image.width >= 165 -%}{{ display_image | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if display_image.width >= 330 -%}{{ display_image | image_url: width: 330 }} 330w,{%- endif -%}
                {%- if display_image.width >= 535 -%}{{ display_image | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if display_image.width >= 750 -%}{{ display_image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if display_image.width >= 1000 -%}{{ display_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                {%- if display_image.width >= 1500 -%}{{ display_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if display_image.width >= 3000 -%}{{ display_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                {{ display_image | image_url }} {{ display_image.width }}w
              "
              src="{{ display_image | image_url: width: 1500 }}"
              sizes="
                (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                calc(100vw - 3rem)
              "
              alt="{{ display_image.alt | default: card_collection.title | escape }}"
              height="{{ display_image.height }}"
              width="{{ display_image.width }}"
              loading="lazy"
              class="motion-reduce"
            >
          </div>
          {%- if card_collection != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if card_collection == blank -%}
        <div class="card__media">
          {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if card_collection != blank -%}
    <div class="card__title-wrapper">
      <h3 class="card__title">
        <a
          href="{{ card_collection.url }}"
          class="full-unstyled-link"
          style="text-decoration: none; color: inherit;"
        >
          {%- if card_collection.title != blank -%}
            {{- card_collection.title | escape -}}
          {%- else -%}
            {{ 'onboarding.collection_title' | t }}
          {%- endif -%}
        </a>
      </h3>
    </div>
  {%- else -%}
    <div class="card__title-wrapper" style="text-align: center; margin-top: 0.5rem;">
      <h3 class="card__title" style="font-weight: bold; margin: 0; padding: 0;">
        <a role="link" aria-disabled="true" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
          {{ 'onboarding.collection_title' | t }}
        </a>
      </h3>
    </div>
  {%- endif -%}
</div>
